static func label(key: String, language: String, values := {}) -> String:
	var pair = TEXT.get(key, [key, key])
	var result: String = pair[1] if language == "en" else pair[0]
	for field in values:
		result = result.replace("{%s}" % field, str(values[field]))
	return result
