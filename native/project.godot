config_version=5

[application]
config/name="OUR-pianoroll"
config/version="1.0.8"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.png"
config/windows_native_icon="res://assets/icon.ico"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1200
window/size/window_height_override=750
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.06, 0.03, 0.045, 1)
